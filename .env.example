# CPI Log Explorer — App Configuration
# Copy to .env and adjust as needed.
#
# Tenant credentials go in tenants.jsonc (see tenants.jsonc.example).

# Set to true to use local sample files instead of calling the real CPI API
MOCK=false
# Concurrent file downloads per tenant/log_type during a fetch job (default 4).
# CPI's LogFiles $value endpoint has high per-file latency (server-side
# decompression, ~30-90s/file observed) — measured only ~24% speedup at
# concurrency=2 vs sequential, suggesting partial server-side throttling.
# Raise cautiously and watch for 429/5xx warnings in the fetch log.
FETCH_CONCURRENCY=4

# Optional automatic log retention: delete entries older than N days on a
# recurring schedule (0 = disabled, manual /api/db/cleanup only).
RETENTION_DAYS=0
RETENTION_CHECK_HOURS=24

# Memory budget. DuckDB would otherwise take 80% of the RAM it sees (inside
# Docker: the whole VM) and get the app OOM-killed. Keep DUCKDB_MEMORY_LIMIT
# well below the container limit APP_MEM_LIMIT (docker-compose.yml).
DUCKDB_MEMORY_LIMIT=1.5GB
DUCKDB_THREADS=4
# Optional spill directory for large sorts/aggregations (default: <db file>.tmp)
# DUCKDB_TEMP_DIR=/data/duckdb_tmp
# WAL size that triggers an automatic checkpoint (DuckDB default 16MB is too
# small for bulk imports)
DUCKDB_CHECKPOINT_THRESHOLD=512MB
APP_MEM_LIMIT=4g

# Logging to stdout: LOG_LEVEL debug|info|warning|error, LOG_FORMAT text|json
LOG_LEVEL=info
LOG_FORMAT=text
# Exit (and let Docker restart the app) if the event loop is blocked this long; 0 disables
WATCHDOG_STALL_SECONDS=120
# Seconds the Stats page result is cached (dropped on import/cleanup/clear)
STATS_CACHE_SECONDS=30

# Host names the app answers to (comma-separated; "*" disables the check, e.g.
# behind a reverse proxy that sets its own Host). Blocks DNS-rebinding attacks.
ALLOWED_HOSTS=localhost,127.0.0.1
# Extra origins allowed to call the API from a browser (default: none; the UI
# itself is same-origin and needs no CORS).
# CORS_ORIGINS=https://my-dashboard.example

# Host interface the port is published on (docker-compose.yml). Keep the
# loopback default unless the instance is protected, e.g. by a reverse proxy.
BIND_ADDRESS=127.0.0.1
